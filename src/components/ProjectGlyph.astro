---
import { projectGlyphs, type ProjectGlyphName } from '../data/project-glyphs';

interface Props {
  name: ProjectGlyphName;
  class?: string;
}

const { name, class: className } = Astro.props;
const art = projectGlyphs[name];
---

<span class:list={['glyph', className]} aria-hidden="true">
  <svg viewBox="0 0 48 48" set:html={art} />
  <svg viewBox="0 0 48 48" class="glint" set:html={art} />
</span>

<style>
  /*
    Two copies of the drawing share one square. The first is a faint outline.
    The second is the same outline in the accent colour, hidden except for a
    slanted band that passes over it now and then. Without motion the band
    rests off to the left and only the faint outline shows.
  */
  .glyph {
    display: grid;
    aspect-ratio: 1;
    color: var(--site-line-soft);
  }

  svg {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  svg :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .glint {
    color: var(--site-accent);
    mask-image: linear-gradient(105deg, transparent 43%, #000 50%, transparent 57%);
    mask-size: 300% 100%;
    mask-repeat: no-repeat;
    mask-position: 100% 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .glint {
      animation: glint 6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
      animation-delay: calc(1.6s + var(--order, 0) * 0.9s);
    }

    :global(.group:hover) .glint,
    :global(.group:focus-within) .glint {
      animation: glint-once 1.2s cubic-bezier(0.65, 0, 0.35, 1);
    }

    @keyframes glint {
      30%,
      to {
        mask-position: 0 0;
      }
    }

    @keyframes glint-once {
      to {
        mask-position: 0 0;
      }
    }
  }
</style>
