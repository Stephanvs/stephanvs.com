---
import { destination, projectLabel, type Project } from '../data/projects';

interface Props {
  projects: readonly Project[];
  headingLevel: 2 | 3;
}

const { projects, headingLevel } = Astro.props;
const Heading = `h${headingLevel}` as const;
const focusRing = 'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent';
---

<ul class="border-t border-line">
  {projects.map((project) => {
    const { name, summary, links } = project;
    return (
    <li class="grid grid-cols-1 gap-y-3 border-b border-line-soft py-8 md:grid-cols-4 md:items-baseline md:gap-x-8">
      <p class="font-mono text-xs uppercase tracking-wide text-faint">{projectLabel(project)}</p>
      <div class="md:col-span-2">
        <Heading class="font-serif text-2xl leading-tight tracking-tight lg:text-3xl">
          <a href={links[0].href} {...destination(links[0].href).attrs} class:list={['no-underline transition-colors hover:text-accent', focusRing]}>{name}</a>
        </Heading>
        <p class="mt-3 text-sm leading-relaxed text-quiet">{summary}</p>
      </div>
      <ul class="flex flex-wrap gap-x-5 gap-y-3 md:flex-col">
        {links.map(({ label, href }) => {
          const { arrow, attrs } = destination(href);
          return (
            <li>
              <a href={href} {...attrs} class:list={['font-mono text-xs uppercase tracking-wide underline decoration-accent underline-offset-4 transition-colors hover:text-accent', focusRing]}>
                {label} <span aria-hidden="true">{arrow}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </li>
    );
  })}
</ul>
