---
import katex from 'katex';

interface Props {
  tex: string;
  inline?: boolean;
}

const { tex, inline = false } = Astro.props;
const html = katex.renderToString(tex, { displayMode: !inline, throwOnError: true });
---

{inline ? <Fragment set:html={html} /> : <div class="kf-math" set:html={html} />}
