                    <div class="ls-compare__snippets" data-ls-snippets></div>
                </div>
            </div>
        </section>

        <section id="choose" class="ls-section ls-wide" aria-labelledby="choose-heading">
            <div class="ls-section__intro">
                <p class="ls-kicker">07 · Choosing one</p>
                <h2 id="choose-heading" class="ls-h2">Which language fits your project?</h2>
                <p class="ls-lede">
                    Start from a kind of project, then adjust what matters to you. The fit is a weighted average of
                    the facet scores, reduced when the language is rarely used for that kind of work. It won’t know
                    your team, so treat it as a shortlist, not a verdict.
                </p>
            </div>

            <div class="ls-toolbar">
                <div class="ls-segmented ls-segmented--wrap" role="radiogroup" aria-label="Project">
                    {projects.map((project, index) => (
                        <button type="button" role="radio" aria-checked={index === 0 ? 'true' : 'false'} data-ls-project={project.key}>
                            {project.name}
                        </button>
                    ))}
                </div>
            </div>

            <div class="ls-choose">
                <form class="ls-weights" data-ls-weights>
                    <p class="ls-label">What matters</p>
                    {facets.map((facet) => (
                        <label class="ls-weight">
                            <span class="ls-weight__name">{facet.name}</span>
                            <input type="range" min="0" max="3" step="1" value={projects[0].weights[facet.key]} data-ls-weight={facet.key} />
                            <output data-ls-weight-label={facet.key}>{weightLabels[projects[0].weights[facet.key]]}</output>
                        </label>
                    ))}
                    <label class="ls-weight ls-weight--domain">
                        <span class="ls-weight__name">Kind of work</span>
