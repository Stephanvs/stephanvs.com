                                data-admired={language.admired}
                                data-year={language.year}
                                {...Object.fromEntries(facets.map((facet) => [`data-${facet.key}`, language.scores[facet.key]]))}
                            >
                                <th scope="row">
                                    <a href={`#lang-${language.id}`} class="ls-matrix__name" style={colors(language.family)}>
                                        <span class="ls-swatch" aria-hidden="true"></span>
                                        {language.name}
                                    </a>
                                </th>
                                <td>#{rankOf(language)}</td>
