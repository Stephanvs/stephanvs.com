                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>

            <div id="matrix-traits" role="tabpanel" aria-labelledby="tab-traits" class="ls-scroll" data-ls-panel="traits" hidden>
                <table class="ls-table ls-traits">
                    <thead>
                        <tr>
                            <th scope="col">Language</th>
                            <th scope="col">Typing</th>
                            <th scope="col">Memory</th>
                            <th scope="col">Runs as</th>
                            <th scope="col">Concurrency</th>
                            <th scope="col">Null handling</th>
                            <th scope="col">Packages</th>
                        </tr>
                    </thead>
                    <tbody>
                        {byPopularity.map((language) => (
                            <tr>
                                <th scope="row">
                                    <a href={`#lang-${language.id}`} class="ls-matrix__name" style={colors(language.family)}>
                                        <span class="ls-swatch" aria-hidden="true"></span>
                                        {language.name}
                                    </a>
                                </th>
                                <td><b>{typingLabels[language.typingKind]}</b> {language.typing}</td>
                                <td><b>{memoryLabels[language.memoryKind]}</b> {language.memory}</td>
                                <td><b>{runtimeLabels[language.runtimeKind]}</b> {language.runtime}</td>
                                <td>{language.concurrency}</td>
                                <td>{language.nulls}</td>
                                <td>{language.packages}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <section id="profiles" class="ls-section" aria-labelledby="profiles-heading">
            <div class="ls-section__intro">
                <p class="ls-kicker">10 · Profiles</p>
                <h2 id="profiles-heading" class="ls-h2">All twenty-five, in depth</h2>
                <p class="ls-lede">
                    Each profile covers what the language is for, the idea at its core, its strengths and
                    weaknesses, where it scores high and low, and the same program written in it: {sharedTask.toLowerCase()}
                </p>
            </div>

            <div class="ls-profiles">
                {byFamily.map(({ family, members }) => (
                    <div class="ls-profiles__group">
                        <div class="ls-profiles__head">
                            <h3>{family.name}</h3>
                            <p>{family.blurb}</p>
                        </div>
                        {members.map((language) => {
                            const profile = profiles[language.id];
                            const later = descendants(language);
                            return (
                                <details class="ls-profile" id={`lang-${language.id}`} data-ls-profile={language.id}>
                                    <summary>
                                        <span class="ls-mini" style={colors(language.family)} aria-hidden="true">
                                            <span class:list={['ls-mini__symbol', { 'is-long': language.symbol.length > 2 }]}>{language.symbol}</span>
                                        </span>
                                        <span>
                                            <span class="ls-profile__name">{language.name}</span>
                                            <span class="ls-profile__tagline">{language.tagline}</span>
                                        </span>
                                    </summary>
                                    <div class="ls-profile__body" data-ls-profile-body>
                                        <p class="ls-profile__summary">{profile.summary}</p>
                                        <p class="ls-profile__idea"><span>The big idea</span>{profile.idea}</p>

                                        <div class="ls-profile__pair">
                                            <div>
                                                <h4 class="ls-label">Strengths</h4>
                                                <ul class="ls-list ls-list--plus">{profile.strengths.map((item) => <li>{item}</li>)}</ul>
                                            </div>
                                            <div>
                                                <h4 class="ls-label">Weaknesses</h4>
                                                <ul class="ls-list ls-list--minus">{profile.weaknesses.map((item) => <li>{item}</li>)}</ul>
                                            </div>
                                        </div>

                                        <dl class="ls-profile__pair ls-profile__when">
                                            <div>
                                                <dt class="ls-label">Reach for it for</dt>
                                                <dd>{profile.reachFor}</dd>
                                            </div>
                                            <div>
                                                <dt class="ls-label">Think twice for</dt>
                                                <dd>{profile.avoid}</dd>
                                            </div>
                                        </dl>

                                        <div class="ls-profile__pair">
                                            <dl class="ls-facts">
                                                <div><dt>Created by</dt><dd>{language.creator}</dd></div>
                                                <div><dt>First appeared</dt><dd>{language.year}</dd></div>
                                                <div><dt>Latest</dt><dd>{profile.latest}</dd></div>
                                                <div><dt>Typing</dt><dd>{language.typing}</dd></div>
                                                <div><dt>Memory</dt><dd>{language.memory}</dd></div>
                                                <div><dt>Runs as</dt><dd>{language.runtime}</dd></div>
                                                <div><dt>Concurrency</dt><dd>{language.concurrency}</dd></div>
                                                <div><dt>Null handling</dt><dd>{language.nulls}</dd></div>
                                                <div><dt>Paradigms</dt><dd>{language.paradigms.join(', ')}</dd></div>
                                                <div><dt>Packages</dt><dd>{language.packages}</dd></div>
                                                <div><dt>Home turf</dt><dd>{homeTurf(language).join(', ')}</dd></div>
                                            </dl>
                                            <div>
                                                <h4 class="ls-label">Scores</h4>
                                                <ul class="ls-bars">
                                                    {facets.map((facet) => (
                                                        <li>
                                                            <span>{facet.name}</span>
                                                            <span class="ls-bar" aria-hidden="true"><i style={`--v:${language.scores[facet.key]}`}></i></span>
                                                            <b>{language.scores[facet.key]}</b>
                                                        </li>
                                                    ))}
                                                </ul>
                                                <h4 class="ls-label ls-profile__subhead">Popularity</h4>
                                                <dl class="ls-ranks">
                                                    {popularitySources.map((source) => (
                                                        <div><dt>{source.short}</dt><dd>{formatSourceRank(source.key, language.ranks[source.key])}</dd></div>
                                                    ))}
                                                    <div class="is-total"><dt>Consensus</dt><dd>#{rankOf(language)} of {languages.length}</dd></div>
                                                    <div class="is-total"><dt>Admired</dt><dd>{language.admired.toFixed(1)}%</dd></div>
                                                </dl>
                                            </div>
                                        </div>

                                        <p class="ls-profile__recent"><span>Lately</span>{profile.recent}</p>

                                        <figure class="ls-snippet" data-ls-snippet={language.id}>
                                            <figcaption>
                                                <span>{language.name}</span>
                                                <span>{lineCount(profile.snippet.code)} lines</span>
                                            </figcaption>
                                            <Code code={profile.snippet.code} lang={profile.snippet.lang as never} theme="vitesse-light" />
                                        </figure>

                                        <div class="ls-profile__links">
                                            <div>
                                                <span class="ls-label">Borrowed from</span>
                                                <span class="ls-links">
                                                    {language.influences.map((id) => {
                                                        const other = getLanguage(id);
                                                        return other ? (
                                                            <a href={`#lang-${other.id}`} style={colors(other.family)}>{other.name}</a>
                                                        ) : (
                                                            <span class="is-ancestor">{influenceName(id)}</span>
                                                        );
                                                    })}
                                                </span>
                                            </div>
                                            {later.length > 0 && (
                                                <div>
                                                    <span class="ls-label">Passed ideas to</span>
                                                    <span class="ls-links">
                                                        {later.map((other) => (
                                                            <a href={`#lang-${other.id}`} style={colors(other.family)}>{other.name}</a>
                                                        ))}
                                                    </span>
                                                </div>
                                            )}
                                        </div>
                                    </div>
                                </details>
                            );
                        })}
                    </div>
                ))}
            </div>
        </section>

        <section id="method" class="ls-section" aria-labelledby="method-heading">
            <div class="ls-section__intro">
                <p class="ls-kicker">11 · Method & sources</p>
                <h2 id="method-heading" class="ls-h2">How this was put together</h2>
            </div>
            <div class="prose prose-stone max-w-3xl md:prose-lg prose-a:decoration-orange-700 prose-a:underline-offset-4 prose-a:hover:text-orange-700">
                <h3>Choosing the twenty-five</h3>
                <p>
                    The list starts with the general-purpose languages that rank highest on average across the seven
                    popularity sources, then adds smaller languages that developers rate far above their usage:
                    Elixir, Gleam, Zig, Odin, Clojure, F#, Haskell and Julia. SQL, HTML and CSS, Bash and PowerShell rank
                    near the top of every survey but are left out because you don’t build a whole system in them.
                    SQL deserves a special mention: it is older than all but one language here and will probably
                    outlive most of them. Near misses include Objective-C, Erlang, OCaml, Perl, MATLAB and Visual
                    Basic.
                </p>
                <h3>The eleven facets</h3>
                <p>
                    Every facet is scored from 1 to 10. The scores are editorial: mine, calibrated against
                    benchmarks, studies, and how each language behaves on real projects. They compare languages with
                    each other, so a 5 is middling within this group, not bad in absolute terms.
                </p>
                <dl class="ls-method-facets">
                    {facets.map((facet) => (
                        <div>
                            <dt>{facet.name}</dt>
                            <dd>{facet.basis}</dd>
                        </div>
                    ))}
                </dl>
                <h3>Popularity</h3>
                <p>
                    The popularity rank is not a survey. For each source, every language gets its position among
                    these twenty-five. Languages a source doesn’t rank share the remaining places, and ties share a
                    place. The consensus is the average of those seven positions, and the popularity lens rescales
                    it to 1–10.
                </p>
                <ul>
                    {popularitySources.map((source) => (
                        <li>
                            <a href={source.url}>{source.name}</a> ({source.edition}): {source.measures}
                        </li>
                    ))}
                </ul>
                <p>
                    Some caveats. IEEE Spectrum’s 2026 ranking and JetBrains’ 2026 report weren’t out when this was
                    written, so their 2025 editions are used. PYPL’s Python share jumped by 24 points in a year,
                    which more likely reflects collapsing tutorial searches for everything else than a surge in
                    Python. TIOBE changed its method in October 2026 to include Mandarin search terms, which
                    probably explains sudden jumps for Julia, Dart and OCaml. GitHub ranks by contributors rather
                    than code, and JetBrains’ audience leans towards users of JetBrains tools. That is the point of
                    using seven sources: their biases point in different directions.
                </p>
                <h3>Admiration</h3>
                <p>
                    “Admired” is the share of a language’s current users who want to keep using it, from the{' '}
                    <a href="https://survey.stackoverflow.co/2026/technology">2026 Stack Overflow survey</a>. It is
                    the only large survey that asks this for every language. Its respondents skew towards web
                    developers, and small languages benefit from self-selection, so it is shown as its own lens and
                    never mixed into the popularity rank.
                </p>
                <h3>The shared program</h3>
                <p>
                    Every profile includes the same task written idiomatically: {sharedTask.toLowerCase()} Eleven of the
                    twenty-five were compiled and run with current toolchains (C, C++, C#, F#, Java, JavaScript,
                    Odin, Python, Rust, TypeScript and Zig 0.17). The rest were written against current documentation and
                    checked by hand. If you spot a mistake, I’d like to hear about it.
                </p>
                <h3>Other sources</h3>
                <ul>
                    <li>Pereira et al., <a href="https://greenlab.di.uminho.pt/wp-content/uploads/2017/10/sleFinal.pdf">Energy Efficiency across Programming Languages</a> (SLE 2017), for relative speed and energy use.</li>
                    <li>Microsoft Security Response Center, <a href="https://msrc.microsoft.com/blog/2019/07/we-need-a-safer-systems-programming-language">We need a safer systems programming language</a> (2019), and the <a href="https://www.chromium.org/Home/chromium-security/memory-safety/">Chromium memory safety</a> page.</li>
                    <li>Google Security, <a href="https://security.googleblog.com/2024/09/eliminating-memory-safety-vulnerabilities-Android.html">Eliminating memory safety vulnerabilities at the source</a> (2024) and <a href="https://blog.google/security/rust-in-android-move-fast-fix-things/">Rust in Android</a> (2025).</li>
                    <li>The White House ONCD, <a href="https://bidenwhitehouse.archives.gov/oncd/briefing-room/2024/02/26/press-release-technical-report/">Back to the Building Blocks</a> (2024), and CISA, <a href="https://www.cisa.gov/resources-tools/resources/product-security-bad-practices">Product Security Bad Practices</a> (2025).</li>
                    <li>Microsoft, <a href="https://devblogs.microsoft.com/typescript/typescript-native-port/">A 10x faster TypeScript</a> (2025).</li>
                    <li>Mündler et al., <a href="https://arxiv.org/abs/2504.09246">Type-Constrained Code Generation with Language Models</a> (PLDI 2025).</li>
                    <li>Cassano et al., <a href="https://arxiv.org/abs/2208.08227">MultiPL-E</a> (2022) and <a href="https://arxiv.org/abs/2308.09895">MultiPL-T</a> (2023), on language models and less common languages.</li>
                    <li><a href="https://devjobsscanner.com/blog/top-8-most-demanded-programming-languages">DevJobsScanner</a>, for job postings by language in 2025.</li>
                </ul>
                <p>
                    Data as of {formatDate(post.date)}. Languages move quickly, and so will some of these numbers.
                    Disagree with a score? Good. The useful part of a spectrum like this is the argument it starts
                    about which trade-offs matter for the system in front of you.
                </p>
            </div>
        </section>
    </article>

