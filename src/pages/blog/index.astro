---
import Card from '../../components/Card.astro';
import Layout from '../../layouts/Layout.astro';
import { formatDate, getPostSummaries } from '../../lib/content';

const posts = await getPostSummaries();
---

<Layout title="Blog" description="Writing about software architecture, engineering, and tools.">
  <section class="py-16 md:py-20">
    <h1 class="mb-10 font-serif text-6xl leading-none tracking-tighter md:text-8xl">Blog</h1>
    <div class="grid grid-cols-1 border-t border-line md:grid-cols-2 md:gap-x-8">
      {posts.map((post) => (
        <Card
          href={post.href}
          image={post.image}
          meta={formatDate(post.date)}
          title={post.title}
          excerpt={post.excerpt}
        />
      ))}
    </div>
  </section>
</Layout>
