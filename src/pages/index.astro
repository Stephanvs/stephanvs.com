---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Card from "../components/Card.astro";
import SectionHead from "../components/SectionHead.astro";
import Layout from "../layouts/Layout.astro";
import { contentSlug, formatDate, getPostSummaries } from "../lib/content";
import avatar from "../../content/pages/home/stephanvs.png";

const pages = await getCollection("pages");
const home = pages.find((page) => contentSlug(page.id) === "home");

if (!home) throw new Error("Home content was not found");

const { Content } = await render(home);
const posts = (await getPostSummaries()).slice(0, 3);
const works = (await getCollection("work")).slice(0, 2);
const headingLines = home.data.title.split("\n");
---

<Layout title="Home" description={home.data.excerpt}>
    <section class="grid gap-12 border-b border-line py-16 md:py-24 lg:grid-cols-[minmax(0,680px)_15rem] lg:items-end lg:justify-between lg:gap-16">
        <div>
            <p class="hero-rise font-mono text-xs uppercase tracking-widest text-accent">
                Independent software architect &rarr; Netherlands
            </p>
            <h1 class="hero-rise hero-heading mt-6 max-w-[680px] pb-1 font-serif text-4xl tracking-tighter text-balance sm:text-5xl lg:text-6xl" style="--rise-delay: 80ms">
                {headingLines.map((line) => <span class="block">{line}</span>)}
            </h1>
            <p class="hero-rise mt-6 max-w-[680px] text-xl text-pretty text-muted md:text-2xl" style="--rise-delay: 160ms">{home.data.excerpt}</p>
            <div class="hero-rise mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4" style="--rise-delay: 240ms">
                <a class="inline-flex justify-center bg-fill px-3 py-2 text-base font-semibold text-fill-ink no-underline transition-[background-color,color,scale] duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-accent hover:text-accent-ink active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" href="mailto:stephan@hayman.io?subject=Architecture%20conversation"
                    >Talk through your architecture</a
                >
                <span class="text-sm text-quiet">stephan@hayman.io</span>
            </div>
            <p class="hero-rise mt-8 text-sm text-quiet" style="--rise-delay: 320ms">
                Case studies for <span class="font-semibold text-ink">AFAS</span> and <span class="font-semibold text-ink">Fudura</span>
            </p>
        </div>
        <aside class="hero-rise" style="--rise-delay: 400ms">
            <Image
                src={avatar}
                alt="Portrait of Stephan van Stekelenburg"
                loading="eager"
                fetchpriority="high"
                class="aspect-square w-full max-w-60 border border-line bg-raised object-cover grayscale contrast-125"
            />
            <p class="mt-4 text-sm text-quiet text-pretty">
                Architecture should make change less expensive, not merely make
                diagrams more impressive.
            </p>
        </aside>
    </section>

    <section class="grid gap-8 border-b border-line py-16 lg:grid-cols-3 lg:gap-16 lg:py-20">
        <p class="font-mono text-xs uppercase tracking-widest text-accent">Approach / 01</p>
        <div class="prose prose-stone max-w-none font-serif text-2xl leading-relaxed lg:col-span-2 lg:text-3xl"><Content /></div>
    </section>

    <SectionHead
        kicker="Writing / 02"
        title="Ideas in practice"
        href="/blog"
        linkText="All writing"
    />
    <div class="grid grid-cols-1 border-t border-line md:grid-cols-2 md:gap-x-8">
        {
            posts.map((post) => (
                <Card
                    href={post.href}
                    image={post.image}
                    meta={formatDate(post.date)}
                    title={post.title}
                    excerpt={post.excerpt}
                />
            ))
        }
    </div>

    <SectionHead
        kicker="Selected work / 03"
        title="Systems at scale"
        href="/work"
        linkText="All work"
    />
    <div class="grid grid-cols-1 border-t border-line md:grid-cols-2 md:gap-x-8">
        {
            works.map((item) => (
                <Card
                    href={`/work/${contentSlug(item.id)}/`}
                    image={item.data.image}
                    meta="Case study"
                    title={item.data.title}
                    excerpt={item.data.excerpt}
                />
            ))
        }
    </div>

    <SectionHead
        kicker="Apps / 04"
        title="Popcorn for TeamCity"
        href="/popcorn/"
        linkText="Support and connection help"
    />
    <div class="max-w-3xl border-t border-line pt-6 text-lg leading-relaxed text-muted">
        <p>Check builds on TeamCity Cloud or a self-hosted TeamCity server over HTTPS, read logs, and start or cancel builds from iPhone or iPad. Plain HTTP is not supported.</p>
        <p class="mt-4">For help, email <a class="underline decoration-accent underline-offset-4 hover:text-accent" href="mailto:support@stephanvs.com">support@stephanvs.com</a>.</p>
    </div>
</Layout>
