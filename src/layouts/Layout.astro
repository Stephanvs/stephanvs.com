---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Home',
	description = 'Independent software architect & developer'
} = Astro.props;
const path = Astro.url.pathname;
const pageTitle = `${title} | Stephan van Stekelenburg`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="oklch(97% 0.001 106.424)" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="oklch(14.7% 0.004 49.25)" media="(prefers-color-scheme: dark)" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
		<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<style is:inline>
			html {
				color-scheme: light;
				background-color: oklch(97% 0.001 106.424);
			}
			@media (prefers-color-scheme: dark) {
				html {
					color-scheme: dark;
					background-color: oklch(14.7% 0.004 49.25);
				}
			}
		</style>
	</head>
	<body class="bg-canvas px-5 font-sans text-ink antialiased selection:bg-selection selection:text-selection-ink md:px-12">
		<header class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-5 border-b border-line py-5 sm:min-h-20 sm:flex-row sm:items-center">
			<a href="/" class="font-serif text-2xl font-semibold leading-none no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
				<span class="text-accent">S/</span> Stephan van Stekelenburg
			</a>
			<nav class="w-full overflow-x-auto sm:w-auto" aria-label="Main navigation">
				<ul class="flex list-none gap-6 pb-1 sm:pb-0">
					<li>
						<a
							href="/"
							class:list={[
								'font-mono text-xs uppercase tracking-widest no-underline transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent',
								{ 'text-accent': path === '/' }
							]}>Home</a>
					</li>
					<li>
						<a
							href="/blog"
							class:list={[
								'font-mono text-xs uppercase tracking-widest no-underline transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent',
								{ 'text-accent': path.startsWith('/blog') }
							]}>Blog</a>
					</li>
					<li>
						<a
							href="/work"
							class:list={[
								'font-mono text-xs uppercase tracking-widest no-underline transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent',
								{ 'text-accent': path.startsWith('/work') }
							]}>Work</a>
					</li>
				</ul>
			</nav>
		</header>
		<main class="mx-auto max-w-7xl"><slot /></main>
		<footer class="mx-auto mt-24 flex max-w-7xl flex-col justify-between gap-3 border-t border-line py-8 font-mono text-xs text-faint sm:flex-row">
			<div class="flex flex-col gap-2">
				<span>&copy; {new Date().getFullYear()} Stephan van Stekelenburg</span>
				<span>Software architecture / distributed systems / engineering</span>
			</div>
			<nav class="flex flex-wrap gap-x-5 gap-y-3" aria-label="Product information">
				<a href="/popcorn/" class="underline-offset-4 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">Popcorn support</a>
				<a href="/privacy-policy/" class="underline-offset-4 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">Popcorn privacy</a>
				<a href="/terms-of-service/" class="underline-offset-4 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">Popcorn terms</a>
			</nav>
		</footer>
	</body>
</html>
